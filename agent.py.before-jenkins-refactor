def run_jenkins_repair(
    job_name,
    build_number,
    project_path,
    project_info,
    llm_client,
    jenkins_url="http://localhost:8080"
):
    """
    Diagnose and repair a failed Jenkins Pipeline.

    Jenkins repair is iterative:
        failed build
            -> diagnostics
            -> LLM diagnosis
            -> LLM fix
            -> validation
            -> human approval
            -> checkpoint
            -> apply
            -> commit/push
            -> Jenkins rerun
            -> next failed build, if any

    A maximum of MAX_ATTEMPTS repair attempts is allowed.
    """

    repo_root = Path(project_path).resolve()

    current_build_number = build_number

    attempted_fixes = []

    print("\n========================================")
    print("       JENKINS REPAIR STARTED")
    print("========================================")

    print(f"\nJob: {job_name}")
    print(f"Initial failed build: #{current_build_number}")

    for attempt in range(1, MAX_ATTEMPTS + 1):

        print("\n========================================")
        print(f"       JENKINS REPAIR ATTEMPT {attempt}/{MAX_ATTEMPTS}")
        print("========================================")

        print(f"\nJob: {job_name}")
        print(f"Analyzing build: #{current_build_number}")

        # ========================================================
        # 1. COLLECT FRESH JENKINS DIAGNOSTICS
        # ========================================================

        print("\n===== COLLECTING JENKINS DIAGNOSTICS =====")

        diagnostics = collect_jenkins_diagnostics(
            job_name,
            current_build_number,
            project_path,
            jenkins_url
        )

        if not diagnostics["success"]:
            print("\n❌ Could not collect Jenkins diagnostics.")
            print(diagnostics["error"])
            return False

        print("✅ Jenkins diagnostics collected.")

        # ========================================================
        # 2. CHECK WHETHER CURRENT BUILD ALREADY SUCCEEDED
        # ========================================================

        if diagnostics.get("status") == "SUCCESS":
            print(
                f"\n✅ Jenkins build #{current_build_number} "
                "already succeeded."
            )
            return True

        # ========================================================
        # 3. SHOW CURRENT FAILURE
        # ========================================================

        print("\n===== FAILED COMMAND =====")
        print(diagnostics.get("failed_command", ""))

        # ========================================================
        # 4. ASK LLM FOR DIAGNOSIS
        # ========================================================

        print("\n===== ASKING AI FOR JENKINS DIAGNOSIS =====")

        diagnosis = llm_client.generate_jenkins_diagnosis_from_context(
            diagnostics
        )

        print("\n===== JENKINS DIAGNOSIS =====")
        print(json.dumps(diagnosis, indent=2))

        # ========================================================
        # 5. HANDLE DETERMINISTIC INFRASTRUCTURE FAILURES
        # ========================================================

        docker_diagnostics = diagnostics.get(
            "docker_diagnostics",
            {}
        )

        if docker_diagnostics.get(
            "infrastructure_failure",
            False
        ):

            print(
                "\n❌ Docker/BuildKit infrastructure failure detected."
            )

            print(
                "The failure is not considered a project-code or "
                "Dockerfile defect."
            )

            print(
                "\nEvidence:"
            )

            print(
                docker_diagnostics.get(
                    "evidence",
                    ""
                )
            )

            print(
                "\nRecommended action:"
            )

            print(
                diagnosis.get(
                    "recommended_action",
                    "Repair the Docker/Jenkins infrastructure."
                )
            )

            return False

        # ========================================================
        # 6. ASK LLM FOR FIX
        # ========================================================

        print("\n===== SELECTING SPECIALIZED FIX GENERATOR =====")

        failure_type = diagnosis.get("failure_type", "").lower()

        if failure_type == "docker":

            print(
                "🔧 Routing Jenkins Docker failure to existing "
                "Docker debugging machinery."
            )

            dockerfile_path = Path(project_path) / "Dockerfile"
            dockerignore_path = Path(project_path) / ".dockerignore"

            dockerfile_content = (
                dockerfile_path.read_text()
                if dockerfile_path.exists()
                else ""
            )

            dockerignore_content = (
                dockerignore_path.read_text()
                if dockerignore_path.exists()
                else ""
            )

            app_file = project_info.get(
                "entry_point",
                "app.py"
            )

            app_path = Path(project_path) / app_file

            docker_source_code = (
                app_path.read_text()
                if app_path.exists()
                else ""
            )

            docker_diagnostics = analyze_docker_startup(
                dockerfile_content,
                project_path,
                project_info,
                dockerignore_content,
                diagnostics.get("error", "")
            )

            print("\n===== JENKINS DOCKER STARTUP DIAGNOSTICS =====")
            print(docker_diagnostics)

            prompt = docker_failure_prompt(
                project_path,
                app_file,
                diagnostics.get("error", ""),
                docker_source_code,
                dockerfile_content,
                dockerignore_content,
                docker_diagnostics,
                project_info,
                failed_fix_info=None
            )

            prompt = (
                "This failure occurred during a Jenkins Docker "
                "Build/Runtime stage. Use the Docker diagnostics "
                "and propose a fix to the actual Docker-related "
                "project file. Do not modify the Jenkins pipeline "
                "unless the Jenkins pipeline itself is proven to "
                "be the root cause.\n\n"
                + prompt
            )

            fix = llm_client.generate_fix(prompt)

        elif failure_type == "jenkins":

            print("🔧 Routing failure to Jenkins fix generator.")

            fix = llm_client.generate_jenkins_fix(
                diagnostics,
                diagnosis
            )

        else:

            print(
                f"❌ Unsupported Jenkins failure type: {failure_type}"
            )

            return False

        print("\n===== PROPOSED JENKINS FIX =====")
        print(json.dumps(fix, indent=2))

        if not isinstance(fix, dict):
            print("\n❌ LLM returned an invalid Jenkins fix.")
            return False

        old_command = fix.get("old", "").strip()
        new_command = fix.get("new", "").strip()

        if not old_command or not new_command:
            print("\n❌ Jenkins fix is missing old/new command.")
            return False

        # ========================================================
        # 6. PREVENT REPEATED IDENTICAL FIXES
        # ========================================================

        fix_signature = (
            old_command,
            new_command
        )

        if fix_signature in attempted_fixes:

            print(
                "\n❌ AI proposed the same Jenkins fix again."
            )

            print(f"OLD: {old_command}")
            print(f"NEW: {new_command}")

            print(
                "\nStopping to prevent an infinite repair loop."
            )

            return False

        # ========================================================
        # 7. VALIDATE FIX USING EXISTING validator.py FUNCTIONS
        # ========================================================

        if failure_type == "docker":

            print("\n===== VALIDATING DOCKER FIX =====")

            fix_file = fix.get("file", "").strip()

            if not fix_file:
                print("\n❌ Docker fix is missing target file.")
                return False

            target_path = Path(project_path) / fix_file

            if not target_path.exists():
                print(
                    f"\n❌ Docker fix target does not exist: {fix_file}"
                )
                return False

            current_content = target_path.read_text()

            if fix_file == "Dockerfile":

                validation = validate_dockerfile_fix(
                    current_content,
                    old_command,
                    new_command
                )

            elif fix_file == ".dockerignore":

                validation = validate_dockerignore_fix(
                    current_content,
                    old_command,
                    new_command
                )

            elif fix_file == "requirements.txt":

                validation = validate_requirements_fix(
                    current_content,
                    old_command,
                    new_command
                )

            else:

                validation = validate_python_fix(
                    current_content,
                    old_command,
                    new_command
                )

        elif failure_type == "jenkins":

            print("\n===== VALIDATING JENKINS FIX =====")

            jenkinsfile_path = diagnostics["project_info"].get(
                "jenkinsfile"
            )

            if jenkinsfile_path:

                jenkinsfile_path = (
                    Path(project_path) / jenkinsfile_path
                )

                if not jenkinsfile_path.exists():
                    print("\n❌ Jenkinsfile not found.")
                    return False

                jenkins_pipeline_content = (
                    jenkinsfile_path.read_text()
                )

            else:

                jenkins_pipeline_content = diagnostics[
                    "jenkins_config"
                ]

            validation = validate_jenkins_fix(
                jenkins_pipeline_content,
                fix,
                diagnostics["project_info"]
            )

        else:

            print(
                f"\n❌ No validator available for: {failure_type}"
            )
            return False

        if not validation["valid"]:

            print("\n❌ FIX REJECTED")
            print(validation["reason"])

            return False

        print("\n✅ FIX PASSED VALIDATION")
        print(validation["reason"])


        # ========================================================
        # 8. SHOW FIX
        # ========================================================

        print("\n===== JENKINS FIX =====")

        print("\nStage:")
        print(fix.get("stage"))

        print("\nOLD:")
        print(fix["old"])

        print("\nNEW:")
        print(fix["new"])

        print("\nREASON:")
        print(fix["reason"])

        # ========================================================
        # 9. HUMAN APPROVAL
        # ========================================================

        choice = input(
            "\nApply this Jenkins fix? [y/n]: "
        )

        if choice.lower() != "y":

            print(
                "\n❌ Jenkins fix rejected by human."
            )

            return False

        # ========================================================
        # 10. CREATE GIT CHECKPOINT
        # ========================================================

        print("\n===== CREATING GIT CHECKPOINT =====")

        checkpoint_result = git_checkpoint(
            str(repo_root)
        )

        if not checkpoint_result["success"]:

            print("\n❌ Could not create Git checkpoint.")
            print(checkpoint_result["error"])

            return False

        checkpoint = checkpoint_result["checkpoint"]

        print(
            f"✅ Git checkpoint created: {checkpoint}"
        )

        # ========================================================
        # 11. UPDATE JENKINSFILE
        # ========================================================

        print("\n===== UPDATING JENKINSFILE =====")

        jenkinsfile_path = diagnostics[
            "project_info"
        ].get("jenkinsfile")

        if not jenkinsfile_path:

            print(
                "\n❌ Jenkinsfile was not detected."
            )

            return False

        jenkinsfile_path = Path(project_path) / jenkinsfile_path

        update_result = update_jenkinsfile(
            str(jenkinsfile_path),
            fix["old"],
            fix["new"],
        )

        if not update_result["success"]:

            print("\n❌ Could not update Jenkinsfile.")
            print(update_result["error"])

            print("\n===== ROLLING BACK =====")

            rollback_result = git_rollback(
                str(repo_root),
                checkpoint
            )

            if rollback_result["success"]:
                print("✅ Rollback successful.")
            else:
                print("❌ Rollback failed.")
                print(rollback_result["stderr"])

            return False

        print("✅ Jenkinsfile updated.")

        # ========================================================
        # 12. COMMIT JENKINSFILE FIX
        # ========================================================

        print("\n===== COMMITTING JENKINSFILE FIX =====")

        commit_result = git_commit_file(
            str(repo_root),
            str(jenkinsfile_path),
            "AI debugging fix: repair Jenkins pipeline"
        )

        if not commit_result["success"]:

            print(
                "\n❌ Could not commit Jenkinsfile fix."
            )

            print(commit_result["stderr"])

            print("\n===== ROLLING BACK =====")

            rollback_result = git_rollback(
                str(repo_root),
                checkpoint
            )

            if rollback_result["success"]:
                print("✅ Rollback successful.")
            else:
                print("❌ Rollback failed.")
                print(rollback_result["stderr"])

            return False

        print("✅ Jenkinsfile fix committed.")

        # Record the fix only after the commit succeeded.
        attempted_fixes.append(fix_signature)

        # ========================================================
        # 13. PUSH FIX
        # ========================================================

        print("\n===== PUSHING JENKINSFILE FIX =====")

        push_result = git_push(
            str(repo_root),
            remote="origin",
            branch="main"
        )

        if not push_result["success"]:

            print("\n❌ Could not push Jenkinsfile fix.")
            print(push_result["stderr"])

            print("\n===== ROLLING BACK =====")

            rollback_result = git_rollback(
                str(repo_root),
                checkpoint
            )

            if rollback_result["success"]:
                print("✅ Rollback successful.")
            else:
                print("❌ Rollback failed.")
                print(rollback_result["stderr"])

            return False

        print("✅ Jenkinsfile fix pushed to GitHub.")

        # ========================================================
        # 14. TRIGGER NEW JENKINS BUILD
        # ========================================================

        print("\n===== TRIGGERING JENKINS BUILD =====")

        trigger_result = trigger_jenkins_build(
            job_name,
            jenkins_url
        )

        if not trigger_result["success"]:

            print(
                "\n❌ Could not trigger Jenkins build."
            )

            print(trigger_result["error"])

            return False

        new_build_number = trigger_result[
            "build_number"
        ]

        print(
            f"✅ Jenkins build #{new_build_number} started."
        )

        # ========================================================
        # 15. WAIT FOR BUILD
        # ========================================================

        print(
            "\n===== WAITING FOR JENKINS BUILD ====="
        )

        build_result = wait_for_jenkins_build(
            job_name,
            new_build_number,
            jenkins_url
        )

        if not build_result["success"]:

            print(
                "\n❌ Error while waiting for Jenkins."
            )

            print(build_result["error"])

            return False

        print(
            f"\nJenkins build #{new_build_number} "
            f"finished with status: "
            f"{build_result['status']}"
        )

        # ========================================================
        # 16. SUCCESS
        # ========================================================

        if build_result["status"] == "SUCCESS":

            print(
                "\n🎉 JENKINS REPAIR SUCCESSFUL"
            )

            print(
                f"Build #{new_build_number} passed."
            )

            return True

        # ========================================================
        # 17. FAILURE -> NEXT ITERATION
        # ========================================================

        print(
            "\n❌ JENKINS BUILD FAILED AGAIN."
        )

        if attempt == MAX_ATTEMPTS:

            print(
                "\n❌ Maximum Jenkins repair attempts reached."
            )

            return False

        print(
            "\n🔄 A new Jenkins failure will now be "
            "analyzed from its own logs."
        )

        current_build_number = new_build_number

    # ============================================================
    # MAX ATTEMPTS
    # ============================================================

    print(
        "\n❌ Jenkins repair stopped after "
        f"{MAX_ATTEMPTS} attempts."
    )

    return False


# ============================================================
# START AGENT LOOP
# ============================================================

if jenkins_job is not None:

    print("\n===== JENKINS MODE =====")
    print(f"Job: {jenkins_job}")
    print(f"Failed build: #{jenkins_build}")

    success = run_jenkins_repair(
        job_name=jenkins_job,
        build_number=jenkins_build,
        project_path=project_path,
        project_info=project_info,
        llm_client=llm_client
    )

    if not success:
        sys.exit(1)

else:

    run_agent_loop(
        project_path,
        project_info,
        state,
        llm_client
    )
